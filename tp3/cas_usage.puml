@startuml
' Diagramme de cas d'utilisation — reconstruit à l'identique du modèle tracé en classe
' Système : « Application de gestion de stage »
' Acteurs : Étudiant (haut gauche), Responsable (milieu gauche), Administrateur (bas
' gauche, généralisation vers Responsable), Développeur (droite).
' Se connecter est le cas transversal, inclus par les autres.
skinparam backgroundColor #FBFAF7
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam arrowColor #38506B
skinparam Actor {
  BorderColor #38506B
  BackgroundColor #E8EEF5
}
skinparam usecase {
  BorderColor #C96F28
  BackgroundColor #FFF4E6
}
skinparam rectangle {
  BorderColor #38506B
  BackgroundColor #FFFFFF
}
left to right direction

actor "Étudiant" as Etu
actor "Responsable" as Resp
actor "Administrateur" as Admin
actor "Développeur" as Dev

rectangle "Application de gestion de stage" {
  usecase "Se connecter" as UCConnexion
  usecase "Gérer son compte" as UCGererCompte
  usecase "Soumettre une demande" as UCSoumettre
  usecase "Consulter une demande" as UCConsulter
  usecase "Gérer une demande" as UCGererDemande
  usecase "Confirmer une demande" as UCConfirmer
  usecase "Refuser une demande" as UCRefuser
  usecase "Programmer une soutenance" as UCProgrammer
  usecase "Gérer les comptes" as UCGererComptes
}

' --- associations acteur / cas d'utilisation (lignes pleines) ---
Etu -- UCGererCompte
Resp -- UCGererDemande
Resp -- UCProgrammer
Admin -- UCGererComptes
UCConnexion -right- Dev

' --- généralisation : l'administrateur est un responsable avec des droits étendus ---
Resp <|-- Admin

' --- ramification des deux cas principaux ---
UCGererCompte <|-- UCSoumettre
UCGererCompte <|-- UCConsulter
UCGererDemande <|-- UCConfirmer
UCGererDemande <|-- UCRefuser

' --- inclusion : l'authentification est obligatoire dans chaque parcours ---
UCGererCompte ..> UCConnexion : <<include>>
UCGererDemande ..> UCConnexion : <<include>>
UCProgrammer ..> UCConnexion : <<include>>
UCGererComptes ..> UCConnexion : <<include>>

@enduml
