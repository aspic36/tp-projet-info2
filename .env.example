# --- Application ---
APP_ENV=dev
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

# --- Base de donnees ---
# Valeurs factices : la vraie configuration vit dans .env (non versionne).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stages
DB_USER=stages_app
DB_PASS=changez_moi
DB_CHARSET=utf8mb4

# --- Messagerie et pièces jointes ---
# log = écrit un .eml dans storage/mails ; mail = utilise la fonction mail() de PHP
MAIL_MODE=log
MAIL_FROM=no-reply@campus.test
MAIL_FROM_NAME=Gestion des stages L3 SIL
UPLOAD_MAX_MB=5
