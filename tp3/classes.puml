@startuml
' Modèle de classes — entités imposées par le cours, dessin et cardinalités revisités
skinparam backgroundColor #FBFAF7
skinparam shadowing false
skinparam defaultFontName "DejaVu Sans"
skinparam arrowColor #C96F28
skinparam class {
  BorderColor #38506B
  BackgroundColor #F2F6FA
}
top to bottom direction

class Utilisateur {
  +id : int
  +email : string
  +mot_de_passe : string
  +role : enum
  +prenom : string
  +nom : string
  +actif : bool
}
class Etudiant {
  +id : int
  +matricule : string
  +filiere : string
  +promotion : string
}
class Encadreur {
  +id : int
  +grade : string
  +departement : string
}
class Entreprise {
  +id : int
  +raison_sociale : string
  +ville : string
  +email_contact : string
}
class DemandeStage {
  +id : int
  +statut : enum
  +motif : string
  +date_depot : datetime
  +date_decision : datetime
}
class PieceJointe {
  +id : int
  +categorie : enum
  +chemin_fichier : string
  +octets : int
  +controlee : bool
}
class Historique {
  +id : int
  +statut_avant : enum
  +statut_apres : enum
  +motif : string
  +horodatage : datetime
}
class Soutenance {
  +id : int
  +date_heure : datetime
  +salle : string
  +duree_min : int
}

Utilisateur "1" -- "0..1" Etudiant : possède >
Utilisateur "1" -- "0..1" Encadreur : est >
Utilisateur "1" -- "0..*" Historique : écrit >
Etudiant "1" -- "0..*" DemandeStage : dépose >
Entreprise "1" -- "0..*" DemandeStage : accueille >
Encadreur "0..1" -- "0..*" DemandeStage : suit >
DemandeStage "1" -- "0..2" PieceJointe : contient >
DemandeStage "1" -- "0..*" Historique : journalise >
DemandeStage "0..1" -- "0..1" Soutenance : aboutit à >
@enduml
